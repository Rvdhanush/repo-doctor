# Copy to .env and fill in. .env is gitignored — never commit real keys.
#   cp .env.example .env
#
# This repo is PUBLIC. A committed key is a public key.

# Groq (free tier, OpenAI-compatible). Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (free tier, OpenAI-compatible endpoint). Get one at
# https://aistudio.google.com/apikey. Used as the fallback when Groq's
# per-minute rate limit is hit -- keep this on a project-specific Google
# account/key, separate from any personal Gemini usage, so its free-tier
# quota is not shared with anything else.
GEMINI_API_KEY=

# Cerebras (free tier, OpenAI-compatible). Get one at
# https://cloud.cerebras.ai/. Third in the fallback order; as of the last
# check this account gets 402 (no free quota) -- kept wired in case that
# changes, costs nothing to leave configured.
CEREBRAS_API_KEY=

# Used from increment 1 (diagnosis) onward.
#   llama-3.3-70b-versatile  - default; good structured-JSON quality
#   llama-3.1-8b-instant     - faster/cheaper fallback
#   openai/gpt-oss-120b      - larger alternative
REPO_DOCTOR_MODEL=llama-3.3-70b-versatile

# Groq free tier is ~12,000 tokens/minute. Keep the diagnosis prompt well under
# this: a large pip failure can approach the whole per-minute budget on its own,
# and increment 2's fix loop makes several calls per repo.
