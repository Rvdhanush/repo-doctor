{
  "name": "repo-doctor",

  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",

  "features": {
    // THE load-bearing line. repo-doctor's whole design is "run the target repo
    // inside a Docker sandbox", so the dev environment needs a real Docker daemon
    // of its own. Without this feature the harness cannot start a container and
    // every run fails at check_docker(). Do not remove it.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "version": "latest"
    },

    // Claude Code preinstalled, so the whole workflow lives in the Codespace and
    // nothing has to be shuttled back to a laptop. Pulls in Node.js if absent.
    // You still authenticate once per Codespace (`claude`, then the browser
    // prompt) — credentials are deliberately not baked into the image.
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // The default 2-core machine is the cheapest against the 120 core-hour monthly
  // allowance (~60 hours). Storage is the real constraint, not CPU: ML installs
  // land in the sandbox container's writable layer, and with docker-in-docker
  // those live on this disk. Run `docker builder prune` if it fills up.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  // Host-side deps only (PyYAML). The sandbox image is built separately, on first
  // run of runner.py or via `docker build -t repo-doctor-sandbox:0.1 ./sandbox`.
  "postCreateCommand": "pip install --user -r requirements.txt",

  // GROQ_API_KEY / CEREBRAS_API_KEY / REPO_DOCTOR_MODEL arrive as Codespaces
  // secrets (repo Settings -> Secrets -> Codespaces), NOT via .env — .env is
  // gitignored and never reaches the container. build_llm_client() reads the
  // process environment, so no .env is needed here.

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "files.eol": "\n"
      }
    }
  },

  "remoteUser": "vscode"
}
